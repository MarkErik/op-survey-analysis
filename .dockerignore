# Ignore R project files
.Rproj.user
.Rhistory
.RData
.Ruserdata
op-survey-analysis.Rproj

# Ignore data files (we want to bind mount these)
*.csv

# Ignore environment variables
.env
.rooignore

# Ignore passwords
.htpasswd
htpasswd

