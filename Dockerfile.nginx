FROM nginx:alpine

# Install logrotate and cron
RUN apk add --no-cache logrotate dcron

# Copy logrotate configuration
COPY logrotate.conf /etc/logrotate.d/nginx

# Create cron entry for logrotate (runs daily at 3:30 AM)
RUN echo "30 3 * * * /usr/sbin/logrotate -f /etc/logrotate.d/nginx" | crontab -

# Start script that runs both cron and nginx
RUN echo '#!/bin/sh' > /entrypoint.sh && \
    echo 'crond -l 2 -f &' >> /entrypoint.sh && \
    echo 'exec nginx -g "daemon off;"' >> /entrypoint.sh && \
    chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
